---
layout: default
---
{% assign year = page.date | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}
{% assign url_beginning = page.url | slice: 0, 6 %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-meta">
      Created on {{ page.date | date: '%B %d, %Y' }}
      {% if page.author %}by {{ page.author }}{% endif %}
      {% if page.last_updated %}, last updated on {{ page.last_updated | date: '%B %d, %Y' }}{% endif %}
      {% if page.meta %}• {{ page.meta }}{% endif %}
    </p>
    <p class="post-tags">
      {% if url_beginning == '/notes/' %}
        <a href="{{ year | prepend: '/notes/' | relative_url }}"> <i class="fa-solid fa-calendar fa-sm"></i> {{ year }} </a>
      {% else %}
        <i class="fa-solid fa-calendar fa-sm"></i> {{ year }}
      {% endif %}
      {% if tags != '' %}
        &nbsp; &middot; &nbsp;
        {% for tag in page.tags %}
          {% if url_beginning == '/notes/' %}
            <a href="{{ tag | slugify | prepend: '/notes/tag/' | relative_url }}"> <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}</a>
          {% else %}
            <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}
          {% endif %}
          {% unless forloop.last %}
            &nbsp;
          {% endunless %}
        {% endfor %}
      {% endif %}

      {% if categories != '' %}
        &nbsp; &middot; &nbsp;
        {% for category in page.categories %}
          {% if url_beginning == '/notes/' %}
            <a href="{{ category | slugify | prepend: '/notes/category/' | relative_url }}"> <i class="fa-solid fa-tag fa-sm"></i> {{ category -}}</a>
          {% else %}
            <i class="fa-solid fa-tag fa-sm"></i> {{ category }}
          {% endif %}
          {% unless forloop.last %}
            &nbsp;
          {% endunless %}
        {% endfor %}
      {% endif %}
    </p>
  </header>

  <article class="post-content">
    {% if page.toc and page.toc.beginning %}
      <div id="table-of-contents">
        {% toc %}
      </div>
      <hr>
    {% endif %}
    <div id="markdown-content">
      {{ content }}
    </div>
  </article>

  {% if page.citation %}
    {% include citation.liquid %}
  {% endif %}

  {% comment %} Kudos button for notes {% endcomment %}
  {% if url_beginning == '/notes' %}
    <div class="kudos-container">
      <button class="kudos-button" id="kudos-btn">
        <span class="kudos-count" id="kudos-count">0</span>
        <span class="kudos-text">kudos</span>
      </button>
      <span class="kudos-label">Click or hold to give kudos!</span>
    </div>
    <script>
      const pageId = '{{ page.url | slugify }}';
      const storageKey = 'kudos_' + pageId;
      const emojis = ['🚀', '👏', '🙏'];
      let holdInterval = null;
      let holdTimeout = null;

      function getKudos() {
        return parseInt(localStorage.getItem(storageKey) || '0');
      }

      function giveKudos() {
        const btn = document.getElementById('kudos-btn');
        const count = getKudos() + 1;
        localStorage.setItem(storageKey, count);
        document.getElementById('kudos-count').textContent = count;

        // Create floating emoji with random selection
        const emoji = document.createElement('span');
        emoji.className = 'kudos-float';
        emoji.textContent = emojis[Math.floor(Math.random() * emojis.length)];
        emoji.style.left = Math.random() * 50 - 25 + 'px';
        btn.appendChild(emoji);

        setTimeout(() => {
          emoji.remove();
        }, 700);
      }

      function startHold() {
        // Give one kudos immediately
        giveKudos();

        // Start trickling after a short delay
        holdTimeout = setTimeout(() => {
          holdInterval = setInterval(() => {
            giveKudos();
          }, 150);
        }, 300);
      }

      function stopHold() {
        if (holdTimeout) {
          clearTimeout(holdTimeout);
          holdTimeout = null;
        }
        if (holdInterval) {
          clearInterval(holdInterval);
          holdInterval = null;
        }
      }

      // Set up event listeners
      const btn = document.getElementById('kudos-btn');
      btn.addEventListener('mousedown', startHold);
      btn.addEventListener('mouseup', stopHold);
      btn.addEventListener('mouseleave', stopHold);
      btn.addEventListener('touchstart', (e) => {
        e.preventDefault();
        startHold();
      });
      btn.addEventListener('touchend', stopHold);

      // Initialize count on page load
      document.getElementById('kudos-count').textContent = getKudos();
    </script>
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --group_by none --cited_in_order %}
    </div>
  {% endif %}

  {% if site.related_blog_posts and site.related_blog_posts.enabled %}
    {% if page.related_posts == null or page.related_posts %}
      {% include related_posts.liquid %}
    {% endif %}
  {% endif %}

  {% if site.disqus_shortname and page.disqus_comments %}
    {% include disqus.liquid %}
  {% endif %}
  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}

  <div class="contribute-notice">
    <i class="fa-brands fa-github"></i>
    <span
      >Found an issue or want to contribute?
      <a href="https://github.com/bviggiano/bviggiano.github.io" target="_blank" rel="noopener noreferrer"
        >GitHub issues and PRs are welcome!</a
      ></span
    >
  </div>
</div>
