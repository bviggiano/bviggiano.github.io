<div class="col">
  <a
    href="{% if project.redirect %}{{ project.redirect }}{% elsif project.github %}{{ project.github }}{% elsif project.huggingface %}{{ project.huggingface }}{% else %}{{ project.url | relative_url }}{% endif %}"
    {% if project.redirect or project.github or project.huggingface %}
      target="_blank" rel="noopener noreferrer"
    {% endif %}
  >
    <div class="card h-100 hoverable">
      {% if project.img %}
        <div
          class="project-thumb"
          style="--thumb-focus: {{ project.img_focus | default: 'center' }}; --thumb-zoom: {{ project.img_zoom | default: 1 }};"
        >
          {%
            include figure.liquid
            loading="eager"
            path=project.img
            sizes = "600px"
            alt="project thumbnail"
            class="card-img-top"
          %}
        </div>
      {% endif %}
      <div class="card-body">
        {% if project.github %}
          {% assign repo_path = project.github | remove: 'https://github.com/' %}
          <h2 class="card-title"><i class="fa-brands fa-github gh-icon"></i> {{ repo_path }}</h2>
          {% if project.description %}
            <p class="card-text">{{ project.description }}</p>
          {% else %}
            <p class="card-text" id="repo-desc-{{ repo_path | slugify }}"></p>
          {% endif %}
          <div class="repo-stats" id="repo-stats-{{ repo_path | slugify }}"></div>
          <script>
            fetch('https://api.github.com/repos/{{ repo_path }}')
              .then(response => response.json())
              .then(data => {
                {% unless project.description %}
                if (data.description) {
                  document.getElementById('repo-desc-{{ repo_path | slugify }}').textContent = data.description;
                }
                {% endunless %}
                const statsEl = document.getElementById('repo-stats-{{ repo_path | slugify }}');
                if (data.stargazers_count !== undefined) {
                  statsEl.innerHTML = `
                    <span class="stat"><i class="fa-solid fa-star"></i> ${data.stargazers_count}</span>
                    <span class="stat"><i class="fa-solid fa-code-fork"></i> ${data.forks_count}</span>
                  `;
                }
              })
              .catch(() => {});
          </script>
        {% elsif project.huggingface %}
          {% assign hf_path = project.huggingface | remove: 'https://huggingface.co/datasets/' | remove: 'https://huggingface.co/' %}
          <h2 class="card-title"><span class="hf-icon">🤗</span> {{ hf_path }}</h2>
          {% if project.description %}
            <p class="card-text">{{ project.description }}</p>
          {% else %}
            <p class="card-text" id="hf-desc-{{ hf_path | slugify }}"></p>
          {% endif %}
          <div class="repo-stats" id="hf-stats-{{ hf_path | slugify }}"></div>
          <script>
            fetch('https://huggingface.co/api/datasets/{{ hf_path }}')
              .then(response => response.json())
              .then(data => {
                {% unless project.description %}
                if (data.description) {
                  document.getElementById('hf-desc-{{ hf_path | slugify }}').textContent = data.description.split('\n')[0];
                }
                {% endunless %}
                const statsEl = document.getElementById('hf-stats-{{ hf_path | slugify }}');
                if (data.downloads !== undefined) {
                  statsEl.innerHTML = `
                    <span class="stat"><i class="fa-solid fa-download"></i> ${data.downloads.toLocaleString()}</span>
                    <span class="stat"><i class="fa-solid fa-heart"></i> ${data.likes}</span>
                  `;
                }
              })
              .catch(() => {});
          </script>
        {% else %}
          <h2 class="card-title">{{ project.title }}</h2>
          <p class="card-text">{{ project.description }}</p>
        {% endif %}
      </div>
    </div>
  </a>
</div>
