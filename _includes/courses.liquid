<div class="col">
  <a href="{{ course.url }}" target="_blank" rel="noopener noreferrer">
    <div class="card h-100 hoverable">
      {% if course.img %}
        {%
          include figure.liquid
          loading="eager"
          path=course.img
          sizes = "150px"
          alt="courseanization thumbnail"
          class="card-img-top"
        %}
      {% endif %}
      <div class="card-body">
        <h6 class="card-title" style="font-size: 0.9em;">{{ course.title }}</h6>
        <p class="card-text" style="font-size: 0.8em;">Primary Instructor: {{ course.instructor }}</p>
        <hr style="margin: 0.5em 0;">
        <p class="card-text" style="font-size: 0.8em; color: gray;">{{ course.description }}</p>
      </div>
    </div>
  </a>
</div>